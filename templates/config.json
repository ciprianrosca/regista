{
  "project": "{{PROJECT}}",
  "plan": ".regista/plan.md",
  "status_file": ".regista/status.md",
  "board_file": ".regista/TODO.md",
  "state_dir": ".regista/state",
  "memory_dir": ".regista/memory",
  "knowledge_file": ".regista/knowledge.json",
  "gates": [
    {
      "name": "tests",
      "run": "echo 'replace with your test command, e.g. uv run pytest -q'",
      "when": [
        "commit"
      ],
      "timeout": 900
    }
  ],
  "protected": [],
  "no_gates_for": [
    "docs/**"
  ],
  "push": "ask",
  "stop": "block",
  "auto_snapshot": true,
  "context": {
    "warn_pct": 55,
    "limit_pct": 65,
    "window": "auto"
  },
  "roles": {
    "source": [
      "src/**"
    ],
    "tests": [
      "tests/**",
      "test/**",
      "**/*_test.*",
      "**/*.test.*",
      "**/test_*.*"
    ],
    "test_config": [
      "**/conftest.py",
      "pytest.ini",
      "tox.ini",
      ".coveragerc",
      "**/jest.config.*",
      "**/vitest.config.*",
      "**/playwright.config.*",
      "**/__snapshots__/**",
      "**/*.snap"
    ]
  },
  "review": {
    "required_for": [
      "src/**"
    ],
    "min_changed_lines": 15,
    "max_rounds": 3,
    "ignore": [
      "__pycache__/",
      "*.pyc",
      "node_modules/",
      ".pytest_cache/",
      ".mypy_cache/",
      ".ruff_cache/",
      "*.egg-info/",
      "dist/",
      "build/",
      ".venv/",
      "coverage/",
      ".coverage"
    ]
  },
  "milestones": "parallel",
  "mode": "orchestrated",
  "requirements": {
    "enforce_coverage": true,
    "milestone_needs_e2e": true
  }
}
